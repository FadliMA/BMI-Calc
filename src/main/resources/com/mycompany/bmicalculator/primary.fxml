<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.bmicalculator.PrimaryController">
   <children>
      <Label text="Berat Badan (kg)" />
      <TextField id="txtBerat" fx:id="txtBerat" />
      <Label text="Tinggi Badan (cm)" />
      <TextField id="txtTinggi" fx:id="txtTinggi" />
      <Button fx:id="primaryButton" onAction="#hitungBMI" text="Hitung BMI" />
      <Label id="lblHasil" fx:id="lblHasil" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
